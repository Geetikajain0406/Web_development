                <p>Good Performance</p>
            ):(
                <p>Needs Improvement</p>
            )
            }</p>
            <p>{props.projectcom >= 5 ?(
                <p>Target Achieved</p>
            ):(
                <p>Target Pending</p>
            )
            }</p>
        </div>
    );
}
export default EmployeeCard;


