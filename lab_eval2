const express = require('express');
const router = express.Router();
let id = 1;
let library = [];


//add
router.post('/',(req,res)=>{
    const{title,author,avail,status} = req.body;
    if(!title || !author){
        return res.send(400).json({message: 'fill details '});
    }
    if(avail < 0){
        return res.send(400).json({message: 'cant be negative avail copies '});
    }
    const lib = {id:id++,title,author,avail,status:'Available'};
    library.push(lib);
    res.send(201).json(library);
   
});
//get
router.get('/',(req,res)=>{
    const lib = library.filter(l=> l.author ===(req.query.author));
    if(lib.length === 0){
         return res.send(400).json({message: 'no author with such name '});
    }
    res.send(200).json(library);
});


exports.module = router;












