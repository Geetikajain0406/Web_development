const express = require('express');
const router = express.Router();
let id = 1;
let veh = [];


//add
router.post('/',(req,res)=>{
    const{name,vnumber,type,status} = req.body;
    if(!name || !vnumber ){
        return res.send(400).json({message: 'fill details '});
    }
    if(type !== 'general' || type !== 'repair' || type !== 'maintainance' ){
        return res.send(400).json({message: 'the type is wrong  '});
    }
    const v = {id:id++,name,vnumber,type,status:'Booked'};
    veh.push(v);
    res.send(201).json(veh);
   
});
//get by id
router.get('/:id',(req,res)=>{
    const v = veh.find(v=> v.id ===Number(req.params.id));
    if(!v){
         return res.send(400).json({message: 'no such id exists'});
    }
    res.send(200).json(veh);
});


// put by id
router.put('/:id',(req,res)=>{
    const v=veh.find(v=> v.id ===Number(req.params.id));
    if(!v){
         return res.send(404).json({message: 'no such id exists'});
    }
    const{name,vnumber,type,status} = req.body;
    if(!name || !vnumber ){
        return res.send(400).json({message: 'fill details '});
    }
    if(type !== 'general' || type !== 'repair' || type !== 'maintainance' ){
        return res.send(400).json({message: 'the type is wrong  '});
    }
   
   
    v.name = name;
    v.vnumber = vnumber;
    v.type= type;
    v.status=status;
    res.status(200).json(veh);




});
exports.module = router;


