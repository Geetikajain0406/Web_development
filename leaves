const express = require('express');
const router = express.Router();
let leaves =[];
let id =1;

//add 
router.post('/',(req,res)=>{
    const{name,dept,type,days,status}= req.body;
    if(!name || !dept || !type || days <=0 ){
        return res.status(400).json({message: 'Invalid data'});
    }
    let leave = {id: id++,name,dept,type ,days,status:'pending'};
    leaves.push(leave);
    res.status(201).json(leave);
});
// get all leaves
router.get('/', (req,res)=>{
    res.status(200).json(leaves);
});// get all leaves by status
router.get('/filter/status', (req,res)=>{
    const leave = leaves.filter(l => 
        l.status === req.query.status
    );

    if(leave.length === 0){
        return res.status(404).json({message: 'no leaves found'});
    }

    res.status(200).json(leave);
});

