const express = require('express');
const router = express.Router();


let students = [];
let id = 1;


// add student
router.post('/', (req,res) =>{
    const{name , course ,sem , email} = req.body;
    if (!name || !course || !email){
        return res.status(400).json({ message: 'Name,course and email required'});
    }
    if(!Number.isInteger(sem) || sem < 1 || sem > 8){
        return res.status(400).json({ message: 'Semester must be btw in 1 and 8 '});
    }
    
    const student = {id: id++,name,course,sem,email};
    students.push(student);
    res.status(201).json(student);
});

// get all student 
router.get('/',(req,res) => {
    res.status(200).json(students);
});

// get student by id
router.get('/:id',(req,res) =>{
    const student = students.find(s => s.id === Number(req.params.id));

    if(!student){
        return res.status(404).json({message: 'student not found'});
    }
    res.status(200).json(student);
});

//update student 
router.patch('/:id',(req,res)=>{
    const student = students.find(s => s.id === Number(req.params.id));
    if(!student){
        return res.status(404).json({message: 'Student not found'});

    }
    const{name, course, sem,email} = req.body;
    if(name !== undefined && !name ||
        course !== undefined && !course ||
        email !== undefined && !email){
            return res.status(400).json({message: 'name,course , email cannot be empty'});
        }
    
    if(sem !== undefined && 
        (!Number.isInteger(sem) || sem< 1 || sem >8)){
            return res.status(400).json({message: 'Invalid semester '});

        }

    Object.assign(student,req.body);
    res.status(200).json(student);



    
});

// delete
router.delete('/:id',(req,res)=>{
    const i = students.findIndex(s => s.id ===Number(req.params.id));

    if(i === -1){
        return res.status(404).json({message: 'Student not found'});
    }
        students.splice(i,1);
        res.status(200).json({message: 'student deleted succesfully'});
        });
module.exports = router;



